{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specadoc project configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1, "type": "integer"},
    "root": {"type": "string", "pattern": "\\S"},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controller": {"$ref": "#/$defs/route"},
        "scout": {"$ref": "#/$defs/route"},
        "worker": {"$ref": "#/$defs/route"},
        "reviewer": {"$ref": "#/$defs/route"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "description": "Variable names or globs whose values verification depends on; others never invalidate evidence",
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"}
        },
        "external_only": {
          "description": "Command fragments that only an external executor runs; a task Verification containing one is refused",
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tidy": {
          "description": "required: pre-review refuses the first initial round until `specadoc_step.py tidy` recorded a pass over Review scope",
          "enum": ["required", "optional"]
        }
      }
    }
  },
  "dependentRequired": {"roles": ["version"]},
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {"runtime": {"enum": ["claude", "codex", "opencode"]}}
    }
  }
}
