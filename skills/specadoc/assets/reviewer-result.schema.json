{
  "description": "Specadoc reviewer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "findings",
    "report"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "location",
          "summary"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "IMPORTANT",
              "MINOR"
            ]
          },
          "location": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "previous",
              "change",
              "new"
            ]
          },
          "class": {
            "type": "string",
            "enum": [
              "data",
              "money",
              "access",
              "user-path",
              "wrong-result",
              "other"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "report": {
      "type": "string"
    }
  }
}
